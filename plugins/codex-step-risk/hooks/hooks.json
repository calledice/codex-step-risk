{
  "description": "Observe supported Codex tool and subagent outcomes; do not change execution.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "timeout": 8,
            "statusMessage": "Analyzing observed step"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "timeout": 8,
            "statusMessage": "Analyzing observed step"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "timeout": 8,
            "statusMessage": "Analyzing observed step"
          }
        ]
      }
    ]
  }
}
